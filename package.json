{
  "name": "geoteknia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test --grep \"sin violaciones críticas axe|teclado: foco en primer error\"",
    "lhci": "lhci autorun",
    "lighthouse": "lhci autorun",
    "ci:lighthouse": "lhci autorun",
    "db:seed": "prisma db seed",
    "test:qa": "vitest run tests/qa --no-file-parallelism",
    "docker:up": "docker compose up -d db",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:web": "docker compose --profile web up -d",
    "docker:web-dev": "docker compose --profile web-dev up -d",
    "docker:logs": "docker compose logs -f",
    "postinstall": "node scripts/patch-eslint-typescript6.mjs",
    "security:install": "pnpm run security:install-tools",
    "security:install-tools": "pnpm run security:install-semgrep && pnpm run security:install-gitleaks",
    "security:install-semgrep": "powershell -ExecutionPolicy Bypass -File scripts/install-semgrep.ps1",
    "security:install-gitleaks": "powershell -ExecutionPolicy Bypass -File scripts/install-gitleaks.ps1",
    "security:sast": "powershell -ExecutionPolicy Bypass -File scripts/semgrep-scan.ps1",
    "security:sca": "powershell -ExecutionPolicy Bypass -File scripts/security-audit.ps1",
    "security:sca:json": "powershell -ExecutionPolicy Bypass -File scripts/security-audit.ps1 -Json",
    "security:secrets": "powershell -ExecutionPolicy Bypass -File scripts/gitleaks-detect.ps1",
    "security:dast": "powershell -ExecutionPolicy Bypass -File scripts/security-dast.ps1",
    "security:scan": "powershell -ExecutionPolicy Bypass -File scripts/security-scan.ps1",
    "security:semgrep": "pnpm run security:sast",
    "security:gitleaks": "pnpm run security:secrets"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@base-ui/react": "^1.7.0",
    "@eslint/eslintrc": "^3.3.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.0-canary.96",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.22",
    "prettier": "^3.9.5",
    "prisma": "^6.19.3",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript6-for-eslint": "npm:typescript@6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@auth/core": "0.41.3",
    "@floating-ui/react": "^0.27.20",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.18",
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.19",
    "@react-email/components": "^1.0.12",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-find-and-replace": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-horizontal-rule": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-list": "^3.29.2",
    "@tiptap/extension-subscript": "^3.29.2",
    "@tiptap/extension-superscript": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-typography": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "argon2": "^0.44.0",
    "clsx": "^2.1.1",
    "isomorphic-dompurify": "^3.19.0",
    "lodash.throttle": "^4.1.1",
    "next": "16.3.0-canary.96",
    "next-auth": "^5.0.0-beta.31",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hotkeys-hook": "^5.3.3",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "pnpm exec tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "next-auth>next": "$next"
    },
    "onlyBuiltDependencies": [
      "argon2",
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
